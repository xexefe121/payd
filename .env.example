# Payd configuration. Everything is optional: with nothing set, Payd runs with a
# simulated PayPal sandbox and rule-based AI fallbacks.

PORT=3000
PAYD_CURRENCY=USD

# --- PayPal sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Save the payer's PayPal wallet on first approval for one-touch taps (needs
# "Save payment methods" enabled on the sandbox app). Set false to disable.
PAYPAL_ENABLE_VAULT=true

# Sandbox accounts that receive money for the seeded demo profiles (optional).
# Without an email, funds settle to the Payd platform sandbox account.
PAYD_SEED_ALICE_EMAIL=
PAYD_SEED_BEN_EMAIL=
PAYD_SEED_MAYA_EMAIL=
PAYD_SEED_CAFE_EMAIL=

# --- Claude (https://platform.claude.com)
ANTHROPIC_API_KEY=
# PAYD_MODEL=claude-opus-5-5
# PAYD_AI=off   # force rule-based fallbacks

# Where the JSON store lives
# PAYD_DATA_DIR=./data
